{
  "freshdesk_subdomain": {
    "display_name": "Freshdesk Subdomain",
    "description": "Your Freshdesk subdomain (e.g. 'mycompany' from mycompany.freshdesk.com)",
    "type": "text",
    "required": true
  },
  "freshdesk_api_key": {
    "display_name": "Freshdesk API Key",
    "description": "Your Freshdesk API key (Profile Settings > Your API Key)",
    "type": "text",
    "required": true,
    "secure": true
  },
  "webhook_url": {
    "display_name": "Webhook URL",
    "description": "The n8n webhook URL to trigger when ticket events occur",
    "type": "text",
    "required": true
  },
  "selected_group_id": {
    "display_name": "Group ID",
    "description": "Group ID to filter events (leave empty for all groups)",
    "type": "text",
    "required": false
  },
  "selected_group_name": {
    "display_name": "Group Name",
    "description": "Selected group name (auto-populated)",
    "type": "text",
    "required": false
  }
}
